# Copy this file to .env for local testing, or add the same names in Render →
# the knightwebstudio-checkout service → Environment. Never put real keys in
# code or commit a .env file — see https://docs.stripe.com/keys-best-practices
#
# Local testing uses TEST keys only (sk_test_/pk_test_). Render uses LIVE keys.
# Get API keys at https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# REQUIRED. Webhook signing secret (whsec_...). Without it /api/webhook rejects
# every event and no confirmation emails are sent. Create the endpoint
# https://knightwebstudio-checkout.onrender.com/api/webhook in Stripe →
# Developers → Webhooks, then copy its signing secret here. Locally, use the
# secret printed by: stripe listen --forward-to localhost:4242/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Confirmation emails, sent through Resend (https://resend.com, free tier).
# Both of these must be set, or emails are skipped (and logged).
#   RESEND_API_KEY  API key from Resend → API Keys (starts with re_).
#   EMAIL_FROM      The sender. Must be on a domain verified in Resend (Gmail
#                   addresses can't be used as a sender on any email service),
#                   e.g. KnightWebstudio <payments@knightwebstudio.com>.
RESEND_API_KEY=re_...
EMAIL_FROM=KnightWebstudio <payments@knightwebstudio.com>

# Optional. Both default to the business inbox, knightwebstudio1@gmail.com:
#   OWNER_EMAIL  where payment notices are sent.
#   REPLY_TO     where a client's reply to their confirmation email goes.
# OWNER_EMAIL=knightwebstudio1@gmail.com
# REPLY_TO=knightwebstudio1@gmail.com

# Optional. Booking link in the client's confirmation email.
# Defaults to https://calendly.com/knightwebstudio1
# CALENDLY_URL=https://calendly.com/knightwebstudio1

# Optional: one extra origin allowed by CORS, in addition to
# https://knightwebstudio.com and http://localhost (e.g. a staging URL).
DOMAIN=http://localhost:3000

# Optional: Stripe Tax. OFF by default: no sales tax is added at checkout.
# Set to true only after Stripe Tax is set up in the Dashboard (Tax →
# Registrations); anything else, or leaving it unset, keeps it off.
# AUTOMATIC_TAX=false

# Optional: port to listen on. Render sets PORT automatically; local default is 4242.
# PORT=4242

# Optional: override the plan -> Price ID whitelist in server/plans.json (e.g.
# with LIVE Price IDs) without a code change. Same shape as plans.json:
# STRIPE_PLANS_JSON={"starter-deposit":{"price":"price_...","mode":"payment"},"essential-care":{"price":"price_...","mode":"subscription"}}
