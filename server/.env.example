# Copy this file to .env and fill in your own values.
# Don't put keys directly in code — see https://docs.stripe.com/keys-best-practices
# Get your API keys at https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret — create an endpoint pointing at /api/webhook at
# https://dashboard.stripe.com/workbench/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: one extra origin allowed by CORS, in addition to
# https://knightwebstudio.com and http://localhost (e.g. a staging URL).
DOMAIN=http://localhost:3000

# Optional: Stripe Tax. Defaults to true (a Louisiana registration is active),
# so Checkout Sessions are created with automatic_tax enabled and sales tax is
# calculated from the billing address. Set to false to turn it off.
# AUTOMATIC_TAX=true

# Optional: port to listen on. Render sets PORT automatically; local default is 4242.
# PORT=4242

# Optional: override the plan -> Price ID whitelist in server/plans.json (e.g.
# with LIVE Price IDs) without a code change. Same shape as plans.json:
# STRIPE_PLANS_JSON={"starter-deposit":{"price":"price_...","mode":"payment"},"essential-care":{"price":"price_...","mode":"subscription"}}
